// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────
// ENUMERATIONS
// ─────────────────────────────────────────────────────

enum Element {
  AERO
  SPECTRO
  FUSION
  ELECTRO
  GLACIO
  HAVOC
}

enum WeaponType {
  BROADBLADE
  SWORD
  PISTOLS
  GAUNTLETS
  RECTIFIER
}

enum Rarity {
  ONE_STAR
  TWO_STAR
  THREE_STAR
  FOUR_STAR
  FIVE_STAR
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

// ─────────────────────────────────────────────────────
// ADMIN USERS
// ─────────────────────────────────────────────────────

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         AdminRole  @default(ADMIN)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]

  @@index([email])
  @@map("admin_users")
}

// ─────────────────────────────────────────────────────
// CHARACTERS
// ─────────────────────────────────────────────────────

model Character {
  id                  String     @id @default(cuid())
  name                String
  nameAr              String?
  slug                String     @unique
  element             Element
  weaponType          WeaponType
  rarity              Rarity     @default(FIVE_STAR)
  portraitPath        String?
  backgroundPath      String?
  iconUrl             String?
  description         String?    @db.Text
  descriptionAr       String?    @db.Text
  quote               String?
  quoteAr             String?
  role                String?
  stats               Json?
  skills              Json?
  ascensionMaterials  Json?
  skillMaterials      Json?
  recommendedWeapons  Json?
  recommendedEchoes   Json?
  teamComps           Json?
  buildTips           String?    @db.Text
  sourceUrl           String?
  sourceVerifiedAt    DateTime?
  isPublished         Boolean    @default(true)
  isComingSoon        Boolean    @default(false)
  releaseVersion      String?
  isFeatured          Boolean    @default(false)
  sortOrder           Int        @default(0)
  tags                String[]   @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([slug])
  @@index([element])
  @@index([weaponType])
  @@index([isPublished])
  @@map("characters")
}

// ─────────────────────────────────────────────────────
// WEAPONS
// ─────────────────────────────────────────────────────

model Weapon {
  id                   String     @id @default(cuid())
  slug                 String     @unique
  name                 String
  nameAr               String?
  weaponType           WeaponType
  rarity               Rarity     @default(FOUR_STAR)
  stars                Int        @default(4)
  iconUrl              String?
  imageBig             String?
  baseAtk              Int?
  secondaryStat        String?
  secondaryStatValue   String?
  skillName            String?
  skillNameAr          String?
  desc                 String?    @db.Text
  descAr               String?    @db.Text
  buffs                Json?
  passiveBuffs         Json?
  stats                Json?
  signatureCharacter   String?
  signatureCharacterId String?
  compatibleCharacters String[]   @default([])
  isPublished          Boolean    @default(true)
  sortOrder            Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([slug])
  @@index([weaponType])
  @@index([rarity])
  @@index([isPublished])
  @@map("weapons")
}

// ─────────────────────────────────────────────────────
// SONATA SETS
// ─────────────────────────────────────────────────────

model SonataSet {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  nameAr                String?
  iconUrl               String?
  twoPieceEffect        String?  @db.Text
  twoPieceEffectAr      String?  @db.Text
  fivePieceEffect       String?  @db.Text
  fivePieceEffectAr     String?  @db.Text
  buffs                 Json?
  calculatorBuffs       Json?
  recommendedCharacters String[] @default([])
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([slug])
  @@map("sonata_sets")
}

// ─────────────────────────────────────────────────────
// ECHOES
// ─────────────────────────────────────────────────────

model Echo {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  nameAr                String?
  echoClass             String?
  cost                  Int      @default(1)
  iconUrl               String?
  cooldown              Float?
  description           String?  @db.Text
  descriptionAr         String?  @db.Text
  sonataSets            String[] @default([])
  buffs                 Json?
  possibleMainStats     Json?
  possibleSubStats      Json?
  recommendedCharacters String[] @default([])
  isPublished           Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([slug])
  @@index([cost])
  @@index([isPublished])
  @@map("echoes")
}

// ─────────────────────────────────────────────────────
// ITEMS & MATERIALS
// ─────────────────────────────────────────────────────

model Item {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameAr        String?
  category      String   @default("COMMON")
  rarity        Int      @default(3)
  iconUrl       String?
  description   String?  @db.Text
  descriptionAr String?  @db.Text
  source        String?
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([rarity])
  @@index([isPublished])
  @@map("items")
}

// ─────────────────────────────────────────────────────
// ENEMIES & BOSSES
// ─────────────────────────────────────────────────────

model Enemy {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameAr        String?
  enemyClass    String?
  elements      String[] @default([])
  hp            Int?
  atk           Int?
  def           Int?
  description   String?  @db.Text
  descriptionAr String?  @db.Text
  iconUrl       String?
  artworkUrl    String?
  stats         Json?
  resistances   Json?
  skills        Json?
  rewards       Json?
  detailUrl     String?
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([enemyClass])
  @@index([isPublished])
  @@map("enemies")
}

// ─────────────────────────────────────────────────────
// TIER LISTS
// ─────────────────────────────────────────────────────

model TierList {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleAr     String?
  gameVersion String   @default("1.4")
  category    String   @default("overall")
  description String?  @db.Text
  tiers       Json
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@map("tier_lists")
}

// ─────────────────────────────────────────────────────
// TEAM COMPOSITIONS
// ─────────────────────────────────────────────────────

model TeamComp {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  titleAr          String?
  description      String?  @db.Text
  descriptionAr    String?  @db.Text
  members          Json
  rotationGuide    String?  @db.Text
  rotationGuideAr  String?  @db.Text
  isFeatured       Boolean  @default(false)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([isFeatured])
  @@index([isPublished])
  @@map("team_comps")
}

// ─────────────────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────────────────

model Announcement {
  id          String   @id @default(cuid())
  title       String
  titleAr     String?
  content     String   @db.Text
  contentAr   String?  @db.Text
  category    String   @default("news")
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPinned])
  @@index([isPublished])
  @@map("announcements")
}


// ─────────────────────────────────────────────────────
// SITE SETTINGS
// ─────────────────────────────────────────────────────

model SiteSetting {
  id           String   @id @default(cuid())
  settingKey   String   @unique
  settingValue String   @db.Text
  description  String?
  updatedAt    DateTime @updatedAt

  @@index([settingKey])
  @@map("site_settings")
}

// ─────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  targetType  String?
  targetId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

