# Environment Variables — Wuthering Waves Builds Hub
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to version control

# ─────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ww_builds_hub"

# ─────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-secure-random-string-at-least-32-chars"
# JWT secret for API tokens
JWT_SECRET="replace-this-with-another-secure-random-string"
# Session cookie max age in seconds (default 8 hours)
SESSION_MAX_AGE=28800

# ─────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─────────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────────
# Absolute path to the persistent storage directory
STORAGE_PATH="./storage"
# Maximum PDF upload size in bytes (default 100MB)
MAX_PDF_SIZE_BYTES=104857600

# ─────────────────────────────────────────────────────
# PDF PROCESSING
# ─────────────────────────────────────────────────────
# DPI for rendering PDF pages (200-300 recommended)
PDF_RENDER_DPI=250
# Image quality for WebP output (0-100)
PDF_IMAGE_QUALITY=90

# ─────────────────────────────────────────────────────
# SUPABASE STORAGE (required for image migration script)
# ─────────────────────────────────────────────────────
# Project URL: Supabase dashboard → Settings → API → Project URL
# SUPABASE_URL="https://<ref>.supabase.co"
# Service role key: Supabase dashboard → Settings → API → service_role key
# WARNING: Keep this secret. It bypasses Row Level Security.
# SUPABASE_SERVICE_KEY="eyJ..."

# Storage bucket name for guide page images (default: guide-images)
# MIGRATION_BUCKET="guide-images"

# ─────────────────────────────────────────────────────
# S3-COMPATIBLE STORAGE (OPTIONAL — leave empty for local)
# ─────────────────────────────────────────────────────
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""

# ─────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────
# Number of login attempts before rate limiting (per 15 min window)
LOGIN_RATE_LIMIT=10
